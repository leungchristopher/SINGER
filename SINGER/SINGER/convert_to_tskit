#!/usr/bin/env python3

import sys
import os
import argparse
import io
import numpy as np
import tskit
import json

def _loadtxt(path):
    """Load a text file via StringIO (workaround for numpy/macOS APFS read race)."""
    with open(path, 'r') as fh:
        content = fh.read()
    return np.loadtxt(io.StringIO(content))

def read_ts_with_metadata(node_file, edge_file, recomb_file=None):
    """
    Read SINGER ARG output and create tskit TableCollection with full metadata.
    Preserves node times, branch structure, and recombination information.
    """
    node_time = _loadtxt(node_file)
    edge_span = _loadtxt(edge_file)
    edge_span = edge_span[edge_span[:, 2] >= 0, :]
    length = max(edge_span[:, 1])

    tables = tskit.TableCollection(sequence_length=length)
    node_table = tables.nodes
    edge_table = tables.edges

    # Add nodes with metadata storing original times
    prev_time = -1
    node_metadata = []
    for node_id, t in enumerate(node_time):
        if t == 0:
            node_table.add_row(flags=tskit.NODE_IS_SAMPLE, time=0, metadata=json.dumps({"original_time": float(t)}).encode())
            node_metadata.append({"node_id": node_id, "original_time": float(t), "is_sample": True})
        else:
            # Enforce strict time ordering as in original
            t_adjusted = max(prev_time + 1e-4, t)
            node_table.add_row(time=t_adjusted, metadata=json.dumps({"original_time": float(t), "adjusted": bool(t_adjusted != t)}).encode())
            node_metadata.append({"node_id": node_id, "original_time": float(t), "adjusted_time": t_adjusted, "is_sample": False})
            prev_time = t_adjusted

    # Add edges
    parent_indices = np.array(edge_span[:, 2], dtype=np.int32)
    child_indices = np.array(edge_span[:, 3], dtype=np.int32)
    edge_table.set_columns(
        left=edge_span[:, 0],
        right=edge_span[:, 1],
        parent=parent_indices,
        child=child_indices
    )

    # Validate edge times
    for i in range(len(parent_indices)):
        j = int(parent_indices[i])
        k = int(child_indices[i])
        if node_time[j] < node_time[k]:
            print(f"WARNING: Invalid time ordering for edge {i}: parent_time={node_time[j]} < child_time={node_time[k]}")

    # Validate edge spans
    for i in range(edge_span.shape[0]):
        if edge_span[i, 0] >= edge_span[i, 1]:
            print(f"WARNING: Invalid edge span at index {i}: {edge_span[i, :]}")

    # Add recombination metadata if provided
    if recomb_file and os.path.exists(recomb_file):
        try:
            recombinations = _loadtxt(recomb_file)
            # Store recombination positions in table metadata
            tables.metadata = json.dumps({
                "num_recombinations": len(recombinations),
                "recombination_positions": recombinations[:, 0].tolist() if len(recombinations.shape) > 1 else [float(recombinations[0])]
            }).encode()
        except:
            pass

    tables.sort()
    return tables, node_metadata

def read_mutation(tables, mutation_file):
    """Read SINGER mutation output with enhanced validation."""
    if not os.path.exists(mutation_file):
        print(f"Warning: mutation file {mutation_file} not found")
        return

    mutations = _loadtxt(mutation_file)
    if len(mutations) == 0:
        return

    n = mutations.shape[0]
    mut_pos = 0
    node_times = tables.nodes.time

    for i in range(n):
        if mutations[i, 0] != mut_pos:
            tables.sites.add_row(position=mutations[i, 0], ancestral_state='0')
            mut_pos = mutations[i, 0]
        site_id = tables.sites.num_rows - 1

        node_id = int(mutations[i, 1])
        # Store full mutation metadata
        metadata = {
            "node": node_id,
            "ancestral_allele": "0",
            "derived_allele": str(int(mutations[i, 3]))
        }
        tables.mutations.add_row(
            site=site_id,
            node=node_id,
            derived_state=str(int(mutations[i, 3])),
            time=node_times[node_id],
            metadata=json.dumps(metadata).encode()
        )

def read_ARG(node_file, branch_file, mutation_file, recomb_file=None):
    """
    Read SINGER ARG files and convert to tskit TreeSequence.

    Args:
        node_file: File with node times
        branch_file: File with branch (edge) definitions
        mutation_file: File with mutations
        recomb_file: (Optional) File with recombination information

    Returns:
        tskit.TreeSequence: Tree sequence with full metadata
    """
    tables, node_metadata = read_ts_with_metadata(node_file, branch_file, recomb_file)
    read_mutation(tables, mutation_file)
    tables.sort()
    tables.build_index()
    tables.compute_mutation_parents()
    ts = tables.tree_sequence()
    return ts


def write_trees(input_prefix, output_prefix, start, end, step, include_recomb=True):
    """Convert SINGER samples to tskit TreeSequence format with metadata."""
    for i in range(start, end, step):
        trees_file = f"{output_prefix}_{i}.trees"
        node_file = f"{input_prefix}_nodes_{i}.txt"
        branch_file = f"{input_prefix}_branches_{i}.txt"
        mutation_file = f"{input_prefix}_muts_{i}.txt"
        recomb_file = f"{input_prefix}_recombs_{i}.txt" if include_recomb else None

        try:
            ts = read_ARG(node_file, branch_file, mutation_file, recomb_file)
            ts.dump(trees_file)
            print(f"Successfully converted {node_file} -> {trees_file}")
        except Exception as e:
            print(f"Error converting sample {i}: {e}", file=sys.stderr)

def write_fast_trees(input_prefix, output_prefix, start, end, step, include_recomb=True):
    """Convert fast-SINGER samples to tskit TreeSequence format with metadata."""
    for i in range(start, end, step):
        trees_file = f"{output_prefix}_{i}.trees"
        node_file = f"{input_prefix}_fast_nodes_{i}.txt"
        branch_file = f"{input_prefix}_fast_branches_{i}.txt"
        mutation_file = f"{input_prefix}_fast_muts_{i}.txt"
        recomb_file = f"{input_prefix}_fast_recombs_{i}.txt" if include_recomb else None

        try:
            ts = read_ARG(node_file, branch_file, mutation_file, recomb_file)
            ts.dump(trees_file)
            print(f"Successfully converted {node_file} -> {trees_file}")
        except Exception as e:
            print(f"Error converting sample {i}: {e}", file=sys.stderr)

def main():
    parser = argparse.ArgumentParser(
        description='Convert SINGER ARG samples to tskit TreeSequence format with full metadata transfer'
    )

    parser.add_argument('-input', type=str, required=True, help='Prefix of ARG input files.')
    parser.add_argument('-output', type=str, required=True, help='Prefix of output .trees files.')
    parser.add_argument('-start', type=int, required=True, help='Start index of the sample.')
    parser.add_argument('-end', type=int, required=True, help='End index of the sample (exclusive).')
    parser.add_argument('-step', type=int, default=1, help='Step size for subsampling. Default: 1.')
    parser.add_argument('-fast', action='store_true', help='Use this flag for fast-SINGER samples.')
    parser.add_argument('--no-recomb', action='store_true', help='Skip recombination file reading (if not available).')

    if len(sys.argv) == 1:
        parser.print_help(sys.stderr)
        sys.exit(1)

    args = parser.parse_args()
    include_recomb = not args.no_recomb

    if args.fast:
        write_fast_trees(args.input, args.output, args.start, args.end, args.step, include_recomb)
    else:
        write_trees(args.input, args.output, args.start, args.end, args.step, include_recomb)

if __name__ == '__main__':
    main()
